import("//base/telephony/call_manager_mini/callmanager_mini.gni")
import("//build/lite/config/component/lite_component.gni")

# Security options (design D12):
# - Kept, from call_manager_mini_cflags_cc: -fno-exceptions -fno-rtti -fstack-protector-all
#   -Wall -Wextra -Werror.
# - -D_FORTIFY_SOURCE=2 is not set: it needs the product libc's fortified headers and an optimised
#   build; enable it in the product toolchain when its libc provides them.
# - cfi / cfi_cross_dso are not applicable: a LiteOS-M image is one static binary without a CFI
#   runtime. Indirect calls are limited to the adapter interfaces registered at build time.
# - branch_protector_ret = "pac_ret" is AArch64 only; LiteOS-M targets are Cortex-M/RISC-V.
# The kernel (CMSIS-RTOS2, los_task), utils_lite and core_service's telephony_errors.h are used
# through their include directories only; the kernel is linked by every LiteOS-M
# image.

if (ohos_kernel_type == "liteos_m") {
  static_library("tel_call_manager_mini") {
    sources = call_manager_mini_sources
    include_dirs =
        call_manager_mini_include_dirs + call_manager_mini_external_include_dirs
    defines = call_manager_mini_defines
    cflags_cc = call_manager_mini_cflags_cc
    deps = [
      "//base/startup/init/interfaces/innerkits:libbegetutil",
      "//foundation/systemabilitymgr/samgr_lite/samgr",
      "//third_party/bounds_checking_function:libsec_static",
    ]
  }

  lite_component("call_manager_mini") {
    features = [ ":tel_call_manager_mini" ]
  }
}
